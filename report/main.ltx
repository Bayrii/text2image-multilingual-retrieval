\section{Reproducing the pipeline}
\begin{lstlisting}[language=bash, caption={Commands to reproduce all reported numbers.}]
# Dependencies
pip install -r requirements.txt
cd frontend && npm install && cd ..

# Data
python scripts/01_download_data.py     # ~10 min, 5000 images
