# Train
python scripts/04_train.py             # ~30-40 min / epoch on RTX 3060

# Evaluate
python scripts/05_build_index.py       # ~11 min, builds image + text idx
python scripts/08_compare_models.py    # ~15 min, writes reports/comparison/

