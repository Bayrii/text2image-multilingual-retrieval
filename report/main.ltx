\section{Configuration excerpt}
\begin{lstlisting}[language=yaml, caption={Final \texttt{config/config.yaml}.}]
data:
  max_images: 5000
  languages: [en, ar, zh, fr, de, ru]
  val_split: 0.1
  test_split: 0.1
model:
  mclip_model: "M-CLIP/XLM-Roberta-Large-Vit-B-32"
  clip_visual: "openai/clip-vit-base-patch32"
  embedding_dim: 512
  freeze_visual_encoder: true
  freeze_text_layers_below: 16
  gradient_checkpointing: true
training:
  batch_size: 8
  learning_rate: 1.0e-5
  warmup_steps: 300
  max_epochs: 15
  gradient_accumulation_steps: 16
  mixed_precision: true
  temperature: 0.07
  hard_negatives_per_sample: 1
  early_stopping_patience: 4
retrieval:
  faiss_index_type: "flat_ip"
  top_n_stage1: 100
  top_k_stage2: 5
\end{lstlisting}

